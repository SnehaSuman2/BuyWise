# ============================================================
# BuyWise environment configuration
# ------------------------------------------------------------
# Copy to .env (never committed). Leave a value empty to keep
# that integration in DEMO / disabled mode. The app switches to
# LIVE automatically when a valid credential is present.
# Only NEXT_PUBLIC_* values are ever sent to the browser.
# ============================================================

# ================================
# APPLICATION
# ================================
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PUBLIC_URL=http://localhost:8000   # public URL of the API (used for redirect links and image uploads)
CORS_ORIGINS=                          # extra comma-separated origins (production: https://www.buywise.co.in)
ADMIN_EMAILS=                          # comma-separated emails granted the admin role on sign-up

# ================================
# SECURITY
# ================================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ================================
# SERPAPI  (ONE key for every engine)
# ================================
SERPAPI_API_KEY=
# The single SerpApi key is used for:
# Google Shopping, Google Product (offers), Amazon Search, Amazon Product,
# Google Search, Google Lens, Google Images, Bing Shopping, Google Reverse Image
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en
SERPAPI_AMAZON_DOMAIN=amazon.in
# Per-engine switches (Phase 1 on, Phase 3 off by default to control cost)
SERPAPI_ENABLE_GOOGLE_SHOPPING=true
SERPAPI_ENABLE_GOOGLE_PRODUCT=true
SERPAPI_ENABLE_AMAZON_SEARCH=true
SERPAPI_ENABLE_AMAZON_PRODUCT=true
SERPAPI_ENABLE_GOOGLE_SEARCH=true
SERPAPI_ENABLE_GOOGLE_LENS=true
SERPAPI_ENABLE_GOOGLE_IMAGES=false
SERPAPI_ENABLE_BING_SHOPPING=false
SERPAPI_ENABLE_GOOGLE_REVERSE_IMAGE=false

# ================================
# AI
# ================================
# Gemini has a free tier — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=auto                    # auto | openai | demo

# ================================
# DATABASE
# ================================
# Production: PostgreSQL. Local dev/tests: SQLite works out of the box.
DATABASE_URL=sqlite+aiosqlite:///./buywise.db
# DATABASE_URL=postgresql+asyncpg://buywise:buywise@localhost:5432/buywise
# Direct (non-pooled) URL for migrations, e.g. Neon/Supabase direct connection. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

# ================================
# REDIS / CACHE / BACKGROUND JOBS
# ================================
REDIS_URL=                          # e.g. redis://localhost:6379/0 (empty = in-memory cache, Celery needs it)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CACHE_TTL_SEARCH_SECONDS=21600
CACHE_TTL_OFFERS_SECONDS=10800
CACHE_TTL_TRUST_SECONDS=604800
OFFER_REFRESH_SECONDS=21600

# ================================
# RAZORPAY
# ================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRO_MONTHLY_PRICE_INR=199
PRO_YEARLY_PRICE_INR=1499

# ================================
# EMAIL / NOTIFICATIONS  (Resend)
# ================================
EMAIL_PROVIDER=auto                 # auto | resend | console
EMAIL_API_KEY=
EMAIL_FROM=BuyWise <alerts@buywise.co.in>

# ================================
# GOOGLE AUTH
# ================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=       # same client id, exposed to the browser for the sign-in button

# ================================
# TRUSTPILOT — OPTIONAL evidence source
# ================================
TRUSTPILOT_ENABLED=false
TRUSTPILOT_API_KEY=
TRUSTPILOT_API_SECRET=
TRUSTPILOT_ACCESS_TOKEN=
TRUSTPILOT_BUSINESS_UNIT_ID=

# ================================
# AFFILIATE (never influences trust or ranking)
# ================================
AMAZON_AFFILIATE_TAG=
FLIPKART_AFFILIATE_ID=

# ================================
# RATE LIMITS / PLAN LIMITS
# ================================
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_AGENT=20/minute
RATE_LIMIT_AUTH=10/minute
FREE_MAX_ALERTS=3
FREE_MAX_SAVED_PRODUCTS=10
PRO_MAX_ALERTS=100
PRO_MAX_SAVED_PRODUCTS=500
FREE_HISTORY_DAYS=30
PRO_HISTORY_DAYS=365
