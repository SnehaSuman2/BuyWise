# Automatic HTTPS from Let's Encrypt. Caddy obtains and renews the certificate
# on its own, provided API_DOMAIN resolves to this machine and ports 80 and 443
# are reachable from the internet.

{$API_DOMAIN} {
	encode gzip

	# The API sets its own security headers; Caddy adds only what a proxy owes.
	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
