# Frontend-only variables. Only NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Google Sign-In client id (public). The secret stays on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional links shown in the footer
NEXT_PUBLIC_GITHUB_URL=
# Server-side only: internal API URL used by Next.js server components (e.g. http://backend:8000 in Docker)
API_INTERNAL_URL=
# Optional: Google Analytics 4 measurement id (public, e.g. G-XXXXXXXXXX). Empty disables analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
